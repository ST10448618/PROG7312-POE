@page "/anomalies"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiClient Api
@inject TelemetryStore Store

<div class="page-header">
    <h1>Anomaly Logs</h1>
    <p class="page-subtitle">Every scored reading, newest first. Your filters are kept when you switch pages.</p>
</div>

<div class="toolbar">
    <input class="field-input" placeholder="Search sensor ID, press Enter" @bind="_search" @bind:event="oninput" @onkeydown="OnKeyDown" />
    <select class="field-select" @bind="_severity" @bind:after="Load">
        <option value="All">All severities</option>
        <option value="Critical">Critical</option>
        <option value="Warning">Warning</option>
        <option value="Disconnected">Disconnected</option>
        <option value="Normal">Normal</option>
    </select>
    <button class="btn-secondary btn-sm" @onclick="Load">Filter</button>
</div>

<div class="card">
    @if (_loadError is not null)
    {
        <div class="alert-banner">@_loadError</div>
    }
    <table class="data-table">
        <thead>
            <tr><th>Timestamp</th><th>Sensor ID</th><th>Severity</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (_logs is not null)
            {
                @foreach (var log in _logs)
                {
                    <tr>
                        <td style="color: var(--text-dim);">@log.Timestamp.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td class="mono">@log.SensorId</td>
                        <td><span class="badge @SeverityBadge(log.Severity)">@log.Severity</span></td>
                        <td>
                            <span style="display: flex; align-items: center; gap: 0.4rem; color: @(log.Acknowledged ? "var(--text-dim)" : "var(--amber)");">
                                @if (!log.Acknowledged)
                                {
                                    <span class="pulse-dot amber"><span class="ping pulse-slow"></span><span class="core"></span></span>
                                }
                                @(log.Acknowledged ? "Acknowledged" : "Unresolved")
                            </span>
                        </td>
                        <td>
                            @if (!log.Acknowledged)
                            {
                                <button class="btn-secondary btn-sm" @onclick="() => Acknowledge(log.Id)">Acknowledge</button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    @if (_logs is not null && _logs.Count == 0)
    {
        <p class="empty-state" style="margin-top: 1rem;">No anomalies match this filter.</p>
    }
</div>

@code {
    private List<AnomalyLogDto>? _logs;
    private string? _loadError;

    // Filters live in the shared store so they survive navigation.
    private string _search { get => Store.LogSearch; set => Store.LogSearch = value; }
    private string _severity { get => Store.LogSeverity; set => Store.LogSeverity = value; }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    private async Task Load()
    {
        try
        {
            _loadError = null;
            _logs = await Api.GetAnomalyLogsAsync(_severity, _search);
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't load anomaly logs.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task Acknowledge(int id)
    {
        await Api.AcknowledgeAnomalyAsync(id);
        await Load();
    }

    private static string SeverityBadge(string severity) => severity switch
    {
        "Critical" => "badge-rose",
        "Warning" => "badge-amber",
        "Disconnected" => "badge-info",
        _ => "badge-emerald"
    };
}