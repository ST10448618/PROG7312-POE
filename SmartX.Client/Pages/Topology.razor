@page "/topology"
@using SmartX.Client.Components
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IDisposable
@inject TelemetryStore Store

<div class="topo-page">

    <div class="page-header">
        <h1>Network Topology &amp; Mesh Routing</h1>
        <p class="page-subtitle">
            Live ESP32 mesh, the power-efficient routing tree and each sensor's history
            @if (Store.MeshHealthChangedAt is { } changed)
            {
                <span> · last topology change @(changed.ToLocalTime().ToString("HH:mm:ss"))</span>
            }
        </p>
    </div>

    @if (Store.MeshError is not null)
    {
        <div class="alert-banner">@Store.MeshError</div>
    }

    @if (Store.Mesh is null || Store.MeshAnalysis is null)
    {
        <p class="empty-state">Loading the mesh…</p>
    }
    else
    {
        var mesh = Store.Mesh;
        var analysis = Store.MeshAnalysis;

        <div class="stat-grid">
            <div class="stat-card">
                <p class="stat-label">Reachable sensors</p>
                <p class="stat-value @(analysis.ReachableCount == SensorCount ? "emerald" : "rose")">@analysis.ReachableCount / @SensorCount</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Nodes down</p>
                <p class="stat-value @(analysis.DownNodes.Count > 0 ? "rose" : "emerald")">@analysis.DownNodes.Count</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">MST total cost</p>
                <p class="stat-value">@analysis.Mst.TotalCost.ToString("0.0")</p>
            </div>
            <div class="stat-card">
                <p class="stat-label">Power saved vs all links</p>
                <p class="stat-value emerald">@(analysis.MstSavingsPercent.ToString("0.0"))%</p>
            </div>
        </div>

        <section class="card">
            <div class="topo-bar">
                <button type="button" class="btn-secondary btn-sm @(Store.TopoWhatIf ? "is-on" : "")" @onclick="ToggleWhatIf">
                    What-if mode: @(Store.TopoWhatIf ? "on" : "off")
                </button>
                <button type="button" class="btn-secondary btn-sm @(Store.TopoShowMst ? "is-on" : "")" @onclick="ToggleMst">
                    Show MST: @(Store.TopoShowMst ? "on" : "off")
                </button>
                @if (Store.TopoWhatIf && Store.TopoAssumedDown.Count > 0)
                {
                    <button type="button" class="btn-secondary btn-sm" @onclick="Store.ClearAssumedDownAsync">Reset scenario</button>
                }
            </div>

            @if (Store.TopoWhatIf)
            {
                <p class="topo-whatif-note">
                    What-if mode never touches the devices or the database. Select a node, then choose “Simulate outage”
                    to see how the mesh heals around it.
                </p>
                @if (Store.TopoAssumedDown.Count > 0)
                {
                    <div class="topo-chips">
                        <span class="stat-label">Assumed down:</span>
                        @foreach (var mac in Store.TopoAssumedDown.OrderBy(m => m))
                        {
                            <button type="button" class="topo-chip" title="Restore" @onclick="() => Store.ToggleAssumedDownAsync(mac)">@Short(mac) ✕</button>
                        }
                    </div>
                }
            }
        </section>

        <div class="topo-layout">
            <section class="card topo-map-card">
                <div class="card-header">
                    <h3>Mesh map</h3>
                    <span class="meta">Click a node to trace its route and load its history.</span>
                </div>

                <MeshMap Mesh="mesh"
                         Analysis="analysis"
                         ShowMst="Store.TopoShowMst"
                         SelectedId="Store.TopoSelectedMac"
                         AssumedDown="Store.TopoAssumedDown"
                         RoutePath="MstPath"
                         AltPath="HopPath"
                         OnSelect="Select" />
            </section>

            <section class="card topo-detail-card">
                @if (Selected is { } sel)
                {
                    <div class="card-header">
                        <h3>@(sel.IsGateway ? "Gateway" : $"Node {sel.Label}")</h3>
                        <span class="badge @StatusBadge(sel.Status)">@sel.Status</span>
                    </div>

                    <p class="mono topo-mac">@sel.Id</p>

                    <div class="topo-facts">
                        <div><span class="stat-label">Category</span><span class="topo-fact">@sel.Category</span></div>
                        <div><span class="stat-label">Location</span><span class="topo-fact">@sel.Location</span></div>
                        <div><span class="stat-label">Last value</span><span class="topo-fact mono">@(sel.LastValue is double v ? v.ToString("0.0") : "—")</span></div>
                        <div><span class="stat-label">Links</span><span class="topo-fact mono">@sel.Degree</span></div>
                    </div>

                    @if (Store.TopoWhatIf && !sel.IsGateway)
                    {
                        var assumed = Store.TopoAssumedDown.Contains(sel.Id);
                        <button type="button" class="@(assumed ? "btn-secondary" : "btn-primary") btn-sm" @onclick="() => Store.ToggleAssumedDownAsync(sel.Id)">
                            @(assumed ? "Restore this node" : "Simulate outage of this node")
                        </button>
                    }

                    <p class="stat-label topo-links-title">Links (cheapest first)</p>
                    <div class="topo-links">
                        @foreach (var l in SelectedLinks())
                        {
                            <button type="button" class="topo-link-row" @onclick="() => Select(l.Other.Id)">
                                <span class="mono">@l.Other.Label</span>
                                <span class="topo-link-name">@(l.Other.IsGateway ? "Gateway" : l.Other.Category)</span>
                                <span class="mono topo-link-cost">@l.Edge.Cost.ToString("0.0")</span>
                                <span class="badge @StatusBadge(l.Other.Status)">@(l.Edge.Active ? l.Other.Status : "Inactive")</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <h3>Node details</h3>
                    <p class="empty-state">Select a node on the map to see its location, status and links.</p>
                }
            </section>
        </div>

        <section class="card">
            <div class="card-header">
                <div>
                    <h3>Route finder</h3>
                    <span class="meta">Trace any sensor to the gateway by MAC address or short id (for example 0C)</span>
                </div>
            </div>

            <div class="toolbar">
                <input class="field-input" list="topo-macs" placeholder="AA:BB:CC:00:01:0C or 0C"
                       @bind="Store.TopoSearch" @bind:event="oninput" @onkeydown="OnSearchKey" />
                <datalist id="topo-macs">
                    @foreach (var n in mesh.Nodes.Where(n => !n.IsGateway).OrderBy(n => n.Id))
                    {
                        <option value="@n.Id">@n.Label · @n.Category</option>
                    }
                </datalist>
                <button type="button" class="btn-primary" @onclick="Trace">Trace route</button>
            </div>

            @if (Store.TopoRouteError is not null)
            {
                <p class="status-message error">@Store.TopoRouteError</p>
            }

            @if (Store.TopoRoute is { } report)
            {
                <div class="topo-route-grid">
                    <RouteView Title="Power-efficient route (MST)" Route="report.MstRoute" Tone="emerald" Label="Short" />
                    <RouteView Title="Fewest hops (BFS)" Route="report.FewestHopsRoute" Tone="amber" Label="Short" />
                </div>
                @if (report.RoutesDiffer)
                {
                    <p class="route-note">
                        The two routes differ on purpose. The MST picks the set of links that connects the whole mesh for the
                        least total power, while BFS only counts hops for this one node.
                    </p>
                }
            }
        </section>

        @if (analysis.Reroutes.Count > 0)
        {
            <section class="card">
                <div class="card-header">
                    <div>
                        <h3>Self-healing: where traffic hops now</h3>
                        <span class="meta">@analysis.Reroutes.Count node(s) whose normal route ran through a down node</span>
                    </div>
                </div>
                <div class="topo-table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr><th>Node</th><th>Was hopping via</th><th>Now hops to</th><th>Route cost</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in analysis.Reroutes)
                            {
                                <tr style="cursor: pointer;" @onclick="() => Select(r.Id)">
                                    <td class="mono">@Short(r.Id)</td>
                                    <td class="mono">@(r.OldPath.Count > 1 ? Short(r.OldPath[1]) : "—")</td>
                                    <td class="mono">@(r.NextHop is null ? "—" : Short(r.NextHop))</td>
                                    <td class="mono">@r.OldCost.ToString("0.0") → @(r.NewCost is double c ? c.ToString("0.0") : "none")</td>
                                    <td>
                                        <span class="badge @(r.Stranded ? "badge-rose" : "badge-emerald")">@(r.Stranded ? "Stranded" : "Rerouted")</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="card">
            <div class="card-header">
                <div>
                    <h3>Connected subnets (DFS)</h3>
                    <span class="meta">Working nodes that can still reach each other. A group without the gateway is isolated.</span>
                </div>
            </div>
            <div class="topo-subnets">
                @foreach (var group in analysis.Subnets)
                {
                    <div class="topo-subnet">
                        <span class="badge @(group.ContainsGateway ? "badge-emerald" : "badge-rose")">
                            @(group.ContainsGateway ? "Connected to gateway" : "Isolated")
                        </span>
                        <span class="meta"> @group.Members.Count node(s)</span>
                        <div class="route-hops">
                            @foreach (var member in group.Members)
                            {
                                <span class="topo-hop" title="@member">@Short(member)</span>
                            }
                        </div>
                    </div>
                }
                @if (analysis.DownNodes.Count > 0)
                {
                    <div class="topo-subnet">
                        <span class="badge badge-info">Down</span>
                        <span class="meta"> @analysis.DownNodes.Count node(s) not relaying</span>
                        <div class="route-hops">
                            @foreach (var member in analysis.DownNodes)
                            {
                                <span class="topo-hop" title="@member">@Short(member)</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <TelemetryHistoryPanel />
        <BenchmarkCard />
    }
</div>

@code {
    private int SensorCount => Math.Max((Store.MeshAnalysis?.NodeCount ?? 1) - 1, 0);

    private MeshNodeDto? Selected =>
        string.IsNullOrEmpty(Store.TopoSelectedMac)
            ? null
            : Store.Mesh?.Nodes.FirstOrDefault(n => Same(n.Id, Store.TopoSelectedMac));

    private IReadOnlyList<string>? MstPath =>
        Store.TopoRoute is { MstRoute.Reachable: true } r ? r.MstRoute.Path : null;

    // Only draw the fewest-hops route separately when it actually differs from the MST route.
    private IReadOnlyList<string>? HopPath =>
        Store.TopoRoute is { RoutesDiffer: true, FewestHopsRoute.Reachable: true } r ? r.FewestHopsRoute.Path : null;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        await Store.EnsureTopologyAsync();
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task Select(string id) => Store.SelectNodeAsync(id);
    private Task Trace() => Store.TraceAsync(Store.TopoSearch);
    private Task ToggleWhatIf() => Store.SetWhatIfAsync(!Store.TopoWhatIf);
    private void ToggleMst() => Store.TopoShowMst = !Store.TopoShowMst;

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Trace();
    }

    private string Short(string id)
    {
        var node = Store.Mesh?.Nodes.FirstOrDefault(n => Same(n.Id, id));
        return node?.Label ?? id;
    }

    private List<(MeshEdgeDto Edge, MeshNodeDto Other)> SelectedLinks()
    {
        var result = new List<(MeshEdgeDto, MeshNodeDto)>();
        if (Store.Mesh is null || string.IsNullOrEmpty(Store.TopoSelectedMac)) return result;

        var byId = Store.Mesh.Nodes.ToDictionary(n => n.Id, StringComparer.OrdinalIgnoreCase);
        foreach (var e in Store.Mesh.Edges
                     .Where(e => Same(e.From, Store.TopoSelectedMac) || Same(e.To, Store.TopoSelectedMac))
                     .OrderBy(e => e.Cost))
        {
            var otherId = Same(e.From, Store.TopoSelectedMac) ? e.To : e.From;
            if (byId.TryGetValue(otherId, out var other)) result.Add((e, other));
        }
        return result;
    }

    private static bool Same(string a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private static string StatusBadge(string status) => status switch
    {
        "Critical" => "badge-rose",
        "Warning" => "badge-amber",
        "Disconnected" or "Inactive" => "badge-info",
        "Gateway" => "badge-slate",
        _ => "badge-emerald"
    };

    public void Dispose() => Store.Changed -= OnChanged;
}