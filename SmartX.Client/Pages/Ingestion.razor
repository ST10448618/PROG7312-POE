@page "/ingestion"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IAsyncDisposable
@inject SensorApiClient Api
@inject ApiConfig Config

<div class="page-header">
    <h1>Data Ingestion</h1>
    <p class="page-subtitle">ESP32 Sensors → .NET API → Ingestion Gateway → Anomaly Engine</p>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

<div style="display: flex; gap: 1.5rem; align-items: flex-start; margin-bottom: 1.5rem;">
    <section class="card" style="max-width: 480px; flex-shrink: 0;">
        <h3 style="margin-bottom: 1rem;">Register a sensor</h3>
        <EditForm Model="_newSensor" OnValidSubmit="RegisterSensor">
            <div class="form-field">
                <label>MAC Address</label>
                <InputText @bind-Value="_newSensor.MacAddress" placeholder="AA:BB:CC:00:11:22" />
            </div>
            <div class="form-field">
                <label>Deployment Location</label>
                <InputText @bind-Value="_newSensor.Location" placeholder="Facility A/Zone 1/Sub-Zone B/Rack 1" />
            </div>
            <div class="form-field">
                <label>Category</label>
                <InputSelect @bind-Value="_newSensor.Category">
                    <option value="">Select…</option>
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </InputSelect>
            </div>
            <button type="submit" class="btn-primary" style="width: 100%;">Register sensor</button>
        </EditForm>
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <p class="status-message @(_statusOk ? "ok" : "error")">@_statusMessage</p>
        }

        <hr style="border: none; border-top: 1px solid var(--line); margin: 1.25rem 0;" />

        <h3 style="margin-bottom: 0.5rem;">Deployment path validator</h3>
        <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.75rem;">Recursively validates a facility hierarchy path.</p>
        <div style="display: flex; gap: 0.5rem;">
            <input @bind="_pathToValidate" placeholder="Facility A/Zone 1/Sub-Zone B/Rack 1"
                   style="flex: 1; background: var(--bg); border: 1px solid var(--line); color: var(--text); padding: 0.5rem; border-radius: 6px;" />
            <button class="btn-secondary" @onclick="ValidatePath">Validate</button>
        </div>
        @if (_pathResult is not null)
        {
            <p class="status-message @(_pathResult == true ? "ok" : "error")">
                @(_pathResult == true ? "Path is valid." : "Path could not be resolved.")
            </p>
        }
    </section>

    <div class="pipeline-grid-2x2">
        <div class="pipeline-stage">
            <p>ESP32 Sensors</p>
            <p class="pipeline-metric">@(_summary?.TotalSensors ?? 0)</p>
            <span class="badge badge-emerald">Healthy</span>
        </div>
        <div class="pipeline-stage">
            <p>.NET API Layer</p>
            <p class="pipeline-metric">@(_health?.DbConnected == true ? "Online" : "Degraded")</p>
            <span class="badge @(_health?.DbConnected == true ? "badge-emerald" : "badge-rose")">@(_health?.DbConnected == true ? "Healthy" : "Error")</span>
        </div>
        <div class="pipeline-stage">
            <p>Ingestion Gateway</p>
            <p class="pipeline-metric">@(_summary?.TotalTelemetryLogs ?? 0) events</p>
            <span class="badge badge-emerald">Healthy</span>
        </div>
        <div class="pipeline-stage">
            <p>Anomaly Engine</p>
            <p class="pipeline-metric">@(_health?.CriticalAnomaliesLast24h ?? 0) alerts/24h</p>
            <span class="badge badge-emerald">Running</span>
        </div>
    </div>
</div>

<section class="card">
    <h3 style="margin-bottom: 1rem;">Registered sensors</h3>
    @if (_sensors.Count == 0)
    {
        <p class="empty-state">No sensors registered yet.</p>
    }
    else
    {
        <table class="data-table sensor-table">
            <thead>
                <tr><th>MAC</th><th>Location</th><th>Category</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var s in _sensors)
                {
                    <tr>
                        <td class="mono">@s.MacAddress</td>
                        <td style="color: var(--text-dim);">@s.Location</td>
                        <td><span class="badge @CategoryBadge(s.Category)">@s.Category</span></td>
                        <td><span class="badge badge-emerald">@s.Status</span></td>
                        <td><button class="btn-secondary btn-sm" @onclick="() => OpenManageModal(s)">Manage</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@if (_managingSensor is not null)
{
    <div class="modal-backdrop">
        <div class="card modal-box" style="width: 460px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 class="mono">@_managingSensor.MacAddress</h3>
                <button class="slideout-close" @onclick="CloseManageModal">✕</button>
            </div>

            <div class="form-field">
                <label>Location</label>
                <input @bind="_editLocation" />
            </div>
            <div class="form-field">
                <label>Category</label>
                <select @bind="_editCategory">
                    <option value="Environmental">Environmental</option>
                    <option value="Power Consumption">Power Consumption</option>
                    <option value="Actuator">Actuator</option>
                </select>
            </div>
            <button class="btn-primary" style="width: 100%; margin-bottom: 1rem;" @onclick="SaveSensorEdit">Save changes</button>

            <hr style="border: none; border-top: 1px solid var(--line); margin: 1rem 0;" />

            <p class="stat-label" style="margin-bottom: 0.5rem;">Attach file</p>
            <InputFile OnChange="e => UploadFile(e, _managingSensor.MacAddress)" />
            @if (_managingSensor.Files.Count > 0)
            {
                <div style="margin-top: 0.75rem; display: flex; flex-direction: column; gap: 0.4rem;">
                    @foreach (var file in _managingSensor.Files)
                    {
                        <a href="@($"{Config.BaseUrl}/api/sensors/{_managingSensor.MacAddress}/files/{file.Id}/download")"
                        target="_blank" class="mono" style="font-size: 0.8rem; color: var(--text-dim);">
                            📄 @file.FileName
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="empty-state" style="margin-top: 0.5rem; font-size: 0.8rem;">No files attached yet.</p>
            }

            <p class="stat-label" style="margin: 1rem 0 0.5rem;">Simulate telemetry</p>
            <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
                <button class="btn-secondary btn-sm" @onclick="() => SimulateReading(_managingSensor.MacAddress)">Normal</button>
                <button class="btn-secondary btn-sm" @onclick="() => SimulateSpike(_managingSensor.MacAddress)">Spike</button>
                <button class="btn-secondary btn-sm" @onclick="() => SimulateDrop(_managingSensor.MacAddress)">Drop</button>
                <button class="btn-secondary btn-sm" @onclick="() => SimulateDisconnect(_managingSensor.MacAddress)">Disconnect</button>
            </div>
            @if (_rowResults.TryGetValue(_managingSensor.MacAddress, out var row))
            {
                @if (row.Ok)
                {
                    <div class="telemetry-result" style="margin-top: 0.6rem;">
                        <span class="badge @ColourBadge(row.Cell!.Colour)">@row.Cell.Colour</span>
                        <span class="telemetry-detail">@row.Cell.Value.ToString("0.0") · score @row.Cell.Score.ToString("0.00")</span>
                    </div>
                }
                else
                {
                    <span class="row-message error">@row.Error</span>
                }
            }

            <hr style="border: none; border-top: 1px solid var(--line); margin: 1rem 0;" />
            <button class="btn-secondary" style="width: 100%; color: var(--rose); border-color: var(--rose);" @onclick="DeleteSensor">
                Delete sensor
            </button>
        </div>
    </div>
}

<section class="card" style="margin-top: 1.5rem;">
    <h3 style="margin-bottom: 1rem;">Power Aggregation (Operator Overloading)</h3>
    <p style="font-size: 0.8rem; color: var(--text-dim); margin-bottom: 0.75rem;">
        Enter any two wattage readings — the API sums them using an overloaded <span class="mono">+</span> operator on <span class="mono">PowerReading</span>.
    </p>
    <div style="display: flex; gap: 0.75rem; align-items: flex-end;">
        <div class="form-field" style="margin-bottom: 0;">
            <label>Meter A (W)</label>
            <input type="number" @bind="_wattsA" />
        </div>
        <div class="form-field" style="margin-bottom: 0;">
            <label>Meter B (W)</label>
            <input type="number" @bind="_wattsB" />
        </div>
        <button class="btn-primary" @onclick="RunAggregateDemo">Aggregate</button>
    </div>
    @if (_aggregateResult is not null)
    {
        <p class="status-message ok">Result: @_aggregateResult</p>
    }
</section>

<div class="card" style="margin-top: 1.5rem;">
    <div class="title-with-dot" style="margin-bottom: 1rem;">
        <h3>Live Events Stream</h3>
        <span class="pulse-dot"><span class="ping pulse-slow"></span><span class="core"></span></span>
    </div>
    <div class="event-stream">
        @if (_liveEvents.Count == 0)
        {
            <span class="empty-state">Waiting for telemetry…</span>
        }
        @foreach (var evt in _liveEvents)
        {
            <div>@evt</div>
        }
    </div>
</div>

@code {
    private SensorDto _newSensor = new();
    private List<SensorDto> _sensors = new();
    private SensorSummaryDto? _summary;
    private SystemHealthDto? _health;
    private string _statusMessage = "";
    private bool _statusOk;
    private string _pathToValidate = "";
    private bool? _pathResult;
    private readonly Random _rnd = new();
    private readonly List<string> _liveEvents = new();
    private HubConnection? _hub;
    private string? _loadError;
    private SensorDto? _managingSensor;
    private string _editLocation = "";
    private string _editCategory = "";
    private double _wattsA = 120;
    private double _wattsB = 80;
    private string? _aggregateResult;
    private readonly Dictionary<string, (bool Ok, AnomalyCellDto? Cell, string? Error)> _rowResults = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await RefreshAll();
            _hub = new HubConnectionBuilder()
                .WithUrl($"{Config.BaseUrl}/hubs/telemetry")
                .WithAutomaticReconnect()
                .Build();
            _hub.On<object>("TelemetryIngested", async evt =>
            {
                try
                {
                    _liveEvents.Insert(0, evt.ToString() ?? "");
                    if (_liveEvents.Count > 15) _liveEvents.RemoveAt(_liveEvents.Count - 1);
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"TelemetryIngested handler failed: {ex}");
                }
            });
            await _hub.StartAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't reach the API or live telemetry hub.";
            Console.Error.WriteLine(ex);
        }
    }

    private async Task RefreshAll()
    {
        _sensors = await Api.GetSensorsAsync() ?? new();
        _summary = await Api.GetSummaryAsync();
        _health = await Api.GetHealthSummaryAsync();
    }

    private async Task RegisterSensor()
    {
        var response = await Api.RegisterAsync(_newSensor);
        _statusOk = response.IsSuccessStatusCode;
        _statusMessage = _statusOk ? $"Registered {_newSensor.MacAddress}." : await response.Content.ReadAsStringAsync();
        if (_statusOk) _newSensor = new();
        await RefreshAll();
    }

    private async Task UploadFile(InputFileChangeEventArgs e, string mac)
    {
        var file = e.File;
        using var content = new MultipartFormDataContent();
        content.Add(new StreamContent(file.OpenReadStream(10 * 1024 * 1024)), "file", file.Name);
        await Api.UploadFileAsync(mac, content);
        await RefreshAll();
        _managingSensor = _sensors.FirstOrDefault(s => s.MacAddress == mac);
    }

    private async Task SimulateReading(string mac)
    {
        var value = (float)Math.Round(_rnd.NextDouble() * 100, 2);
        var (success, cell, error) = await Api.PushMoistureAsync(mac, value);
        _rowResults[mac] = (success, cell, error);
        await RefreshAll();
    }

    private async Task SimulateSpike(string mac)
    {
        var (success, cell, error) = await Api.PushMoistureAsync(mac, 900f);
        _rowResults[mac] = (success, cell, error);
        await RefreshAll();
    }

    private async Task SimulateDrop(string mac)
    {
        var (success, cell, error) = await Api.PushMoistureAsync(mac, -900f);
        _rowResults[mac] = (success, cell, error);
        await RefreshAll();
    }

    private async Task SimulateDisconnect(string mac)
    {
        var response = await Api.MarkDisconnectedAsync(mac);
        if (response.IsSuccessStatusCode)
        {
            var cell = await response.Content.ReadFromJsonAsync<AnomalyCellDto>();
            _rowResults[mac] = (true, cell, null);
        }
        else
        {
            _rowResults[mac] = (false, null, await response.Content.ReadAsStringAsync());
        }
        await RefreshAll();
    }

    private async Task ValidatePath()
    {
        var result = await Api.ValidatePathAsync(_pathToValidate);
        var body = await result.Content.ReadFromJsonAsync<ValidationResult>();
        _pathResult = body?.isValid;
    }

    private record ValidationResult(string path, bool isValid);

    private void OpenManageModal(SensorDto sensor)
    {
        _managingSensor = sensor;
        _editLocation = sensor.Location;
        _editCategory = sensor.Category;
    }

    private void CloseManageModal() => _managingSensor = null;

    private async Task SaveSensorEdit()
    {
        if (_managingSensor is null) return;
        await Api.UpdateSensorAsync(_managingSensor.MacAddress, _editLocation, _editCategory);
        var mac = _managingSensor.MacAddress;
        await RefreshAll();
        _managingSensor = _sensors.FirstOrDefault(s => s.MacAddress == mac);
    }

    private async Task DeleteSensor()
    {
        if (_managingSensor is null) return;
        await Api.DeleteSensorAsync(_managingSensor.MacAddress);
        _managingSensor = null;
        await RefreshAll();
    }

    private static string ColourBadge(string colour) => colour.ToLowerInvariant() switch
    {
        "red" => "badge-rose",
        "amber" => "badge-amber",
        "blue" => "badge-info",
        _ => "badge-emerald"
    };

    private static string CategoryBadge(string category) => category switch
    {
        "Environmental" => "badge-info",
        "Power Consumption" => "badge-amber",
        "Actuator" => "badge-emerald",
        _ => "badge-slate"
    };

    private async Task RunAggregateDemo()
    {
        var response = await Api.AggregatePowerAsync(_wattsA, _wattsB);
        _aggregateResult = await response.Content.ReadAsStringAsync();
    }

    public async ValueTask DisposeAsync()
    {
        try { if (_hub is not null) await _hub.DisposeAsync(); }
        catch { /* connection may never have fully established; safe to ignore on teardown */ }
    }
}