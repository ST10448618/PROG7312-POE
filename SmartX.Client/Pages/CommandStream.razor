@page "/command-stream"
@using Microsoft.AspNetCore.SignalR.Client
@using SmartX.Client.Models
@using SmartX.Client.Services
@implements IAsyncDisposable
@inject SensorApiClient Api
@inject ApiConfig Config

<div class="page-header">
    <div class="title-with-dot">
        <h1>Real-Time Command Stream &amp; History</h1>
        <span class="pulse-dot @ConnectionDotClass"><span class="ping pulse-slow"></span><span class="core"></span></span>
    </div>
    <p class="page-subtitle">
        Live command queue · priority alerts · undo history · <span class="@ConnectionTextClass">@_connectionState</span>
    </p>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

<div class="command-grid">
    <section class="card">
        <h3 style="margin-bottom: 0.75rem;">Command Queue</h3>
        <p class="stat-value">@(_queueDepths?.StandardDepth ?? 0)</p>
        <p class="empty-state">Standard telemetry awaiting processing.</p>
    </section>

    <section class="card">
        <h3 style="margin-bottom: 0.75rem;">Priority Alerts</h3>
        <p class="stat-value rose">@(_queueDepths?.PriorityDepth ?? 0)</p>
        <p class="empty-state">Critical/Warning readings bypassing the standard queue.</p>
    </section>

    <section class="card">
        <h3 style="margin-bottom: 0.75rem;">Issue a command</h3>
        <select @bind="_selectedTargetMac" style="margin-bottom: 0.5rem; width: 100%;">
            <option value="">Select device…</option>
            @foreach (var d in _devices)
            {
                <option value="@d.MacAddress">@d.MacAddress</option>
            }
        </select>
        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
            <button class="btn-secondary btn-sm" @onclick='() => IssueCommand("TriggerPump")'>Trigger Pump</button>
            <button class="btn-secondary btn-sm" @onclick='() => IssueCommand("ToggleRelay")'>Toggle Relay</button>
            <button class="btn-secondary btn-sm" @onclick='() => IssueCommand("ShutdownValve")'>Shutdown Valve</button>
        </div>
        @if (_commandMessage is not null)
        {
            <p class="status-message @(_commandOk ? "ok" : "error")">@_commandMessage</p>
        }
    </section>

    <section class="card">
        <h3 style="margin-bottom: 0.75rem;">Command History</h3>
        @if (_commandHistory.Count == 0)
        {
            <p class="empty-state">No commands issued yet.</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 0.3rem; max-height: 8rem; overflow-y: auto; margin-bottom: 0.5rem;">
                @foreach (var cmd in _commandHistory.Take(5))
                {
                    <div class="mono" style="font-size: 0.78rem; color: var(--text-dim);">
                        @cmd.Type → @cmd.TargetMac (@cmd.IssuedAt.ToLocalTime().ToString("HH:mm:ss"))
                    </div>
                }
            </div>
        }
        <button class="btn-secondary btn-sm" @onclick="UndoLastCommand" disabled="@(_commandHistory.Count == 0)">
            Undo last command
        </button>
    </section>
</div>

<section class="card" style="margin-top: 1.5rem;">
    <div class="card-header">
        <h3>Live Device Registry</h3>
        <span style="font-size: 0.8rem; color: var(--text-dim);">@_devices.Count device(s) tracked</span>
    </div>
    @if (_loadingDevices)
    {
        <p class="empty-state">Loading device registry…</p>
    }
    else if (_devices.Count == 0)
    {
        <p class="empty-state">No devices registered yet.</p>
    }
    else
    {
        <table class="data-table">
            <thead><tr><th>MAC</th><th>Category</th><th>Last Value</th><th>Status</th><th>Last Seen</th></tr></thead>
            <tbody>
                @foreach (var d in _devices.OrderBy(d => d.MacAddress))
                {
                    <tr>
                        <td class="mono">@d.MacAddress</td>
                        <td style="color: var(--text);">@d.Category</td>
                        <td class="mono">@(d.LastValue?.ToString("0.0") ?? "—")</td>
                        <td><span class="badge @StatusBadge(d.Status)">@d.Status</span></td>
                        <td style="color: var(--text-faint); font-size: 0.8rem;">@d.LastSeen.ToLocalTime().ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private HubConnection? _hub;
    private string _connectionState = "Connecting…";
    private string? _loadError;
    private List<SensorDto> _sensors = new();
    private List<LiveDeviceStateDto> _devices = new();
    private bool _loadingDevices = true;
    private QueueDepthDto? _queueDepths;
    private List<DeviceCommandDto> _commandHistory = new();
    private string _selectedTargetMac = "";
    private string? _commandMessage;
    private bool _commandOk;

protected override async Task OnInitializedAsync()
{
    try
    {
        _devices = await Api.GetDeviceRegistryAsync() ?? new();
        _loadingDevices = false;

        _hub = new HubConnectionBuilder()
            .WithUrl($"{Config.BaseUrl}/hubs/telemetry")
            .WithAutomaticReconnect()
            .Build();

        _hub.Reconnecting += _ => { _connectionState = "Reconnecting…"; return InvokeAsync(StateHasChanged); };
        _hub.Reconnected += _ => { _connectionState = "Connected"; return InvokeAsync(StateHasChanged); };
        _hub.Closed += _ => { _connectionState = "Disconnected"; return InvokeAsync(StateHasChanged); };

        _hub.On<object>("QueueDepthChanged", async _ =>
        {
            _queueDepths = await Api.GetQueueDepthsAsync();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<DeviceCommandDto>("CommandIssued", async _ =>
        {
            _commandHistory = await Api.GetCommandHistoryAsync() ?? new();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<DeviceCommandDto>("CommandUndone", async _ =>
        {
            _commandHistory = await Api.GetCommandHistoryAsync() ?? new();
            await InvokeAsync(StateHasChanged);
        });

        _hub.On<List<LiveDeviceStateDto>>("DeviceRegistryUpdated", async devices =>
        {
            try
            {
                _devices = devices;
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"DeviceRegistryUpdated handler failed: {ex}");
            }
        });

        await _hub.StartAsync();
        _connectionState = "Connected";
    }
    catch (Exception ex)
    {
        _loadingDevices = false;
        _connectionState = "Disconnected";
        _loadError = "Couldn't reach the API or live telemetry hub.";
        Console.Error.WriteLine(ex);
    }
}

    private string ConnectionDotClass => _connectionState switch
    {
        "Connected" => "",
        "Reconnecting…" => "amber",
        _ => "rose"
    };

    private string ConnectionTextClass => _connectionState switch
    {
        "Connected" => "",
        "Reconnecting…" => "",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        try { if (_hub is not null) await _hub.DisposeAsync(); }
        catch { /* connection may never have fully established; safe to ignore on teardown */ }
    }

    private static string StatusBadge(string status) => status switch
    {
        "Disconnected" => "badge-info",
        "Critical" => "badge-rose",
        "Warning" => "badge-amber",
        _ => "badge-emerald"
    };

    private async Task IssueCommand(string type)
    {
        if (string.IsNullOrEmpty(_selectedTargetMac))
        {
            _commandMessage = "Select a device first.";
            _commandOk = false;
            return;
        }

        var response = await Api.IssueCommandAsync(_selectedTargetMac, type);
        _commandOk = response.IsSuccessStatusCode;
        _commandMessage = _commandOk ? $"{type} sent to {_selectedTargetMac}." : await response.Content.ReadAsStringAsync();
        await RefreshCommandData();
    }

    private async Task UndoLastCommand()
    {
        var response = await Api.UndoLastCommandAsync();
        _commandMessage = response.IsSuccessStatusCode ? "Last command undone." : "Nothing to undo.";
        _commandOk = response.IsSuccessStatusCode;
        await RefreshCommandData();
    }

    private async Task RefreshCommandData()
    {
        _queueDepths = await Api.GetQueueDepthsAsync();
        _commandHistory = await Api.GetCommandHistoryAsync() ?? new();
    }
    }