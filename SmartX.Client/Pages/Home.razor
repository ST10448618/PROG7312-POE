@page "/"
@using SmartX.Client.Models
@using SmartX.Client.Services
@inject SensorApiClient Api

<div class="page-header">
    <h1>Welcome to Smart-X Telemetry</h1>
    <p class="page-subtitle">
        @DateTime.Now.ToString("dddd, dd MMMM yyyy") ·
        @(_health is null ? "loading system status…" : _health.DbConnected ? "All systems operational" : "Database unreachable")
    </p>
</div>

@if (_loadError is not null)
{
    <div class="alert-banner">@_loadError</div>
}

@if (_summary is not null && _health is not null)
{
    <div class="stat-grid">
        <div class="stat-card">
            <p class="stat-label">Total Nodes</p>
            <p class="stat-value">@_summary.TotalSensors</p>
        </div>
        <div class="stat-card">
            <p class="stat-label">Active Alerts (24h)</p>
            <p class="stat-value rose">@_health.CriticalAnomaliesLast24h</p>
        </div>
        <div class="stat-card">
            <div class="title-with-dot">
                <p class="stat-label">System Uptime</p>
                <span class="pulse-dot"><span class="ping pulse-slow"></span><span class="core"></span></span>
            </div>
            <p class="stat-value">@FormatUptime(_health.UptimeSeconds)</p>
        </div>
        <div class="stat-card">
            <p class="stat-label">Telemetry Readings</p>
            <p class="stat-value">@_summary.TotalTelemetryLogs</p>
        </div>
    </div>
}

<div class="pillar-grid">
    <a href="/dashboard" class="pillar-card">
        <h2>Overview Dashboard →</h2>
        <p>Live anomaly heat map across all sensors.</p>
    </a>
    <a href="/command-stream" class="pillar-card">
        <h2>Command Stream →</h2>
        <p>Live command queue, priority alerts, and undo history.</p>
    </a>
    <a href="/ingestion" class="pillar-card">
        <h2>Data Ingestion →</h2>
        <p>Register devices and monitor the pipeline.</p>
    </a>
    <a href="/integrations" class="pillar-card">
        <h2>Integration →</h2>
        <p>Connect webhook notifications.</p>
    </a>
</div>

<div class="card">
    <h3 style="margin-bottom: 1rem;">Recent Activity</h3>
    @if (_recent is null || _recent.Count == 0)
    {
        <p class="empty-state">No telemetry yet.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 0.6rem;">
            @for (var i = 0; i < _recent.Count; i++)
            {
                var item = _recent[i];
                <div style="display: flex; justify-content: space-between; font-size: 0.875rem; padding-bottom: 0.6rem; border-bottom: 1px solid var(--line);">
                    <span style="display: flex; align-items: center; gap: 0.5rem;">
                        @if (i == 0)
                        {
                            <span class="pulse-dot"><span class="ping pulse-slow"></span><span class="core"></span></span>
                        }
                        <span class="mono">@item.SensorId</span>
                        <span style="color: var(--text-dim);">
                            sent @($"{item.RawValue}{item.Unit}")
                        </span>
                    </span>
                    <span style="color: var(--text-faint);">@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                </div>
            }
        </div>
    }
</div>

@code {
    private SensorSummaryDto? _summary;
    private SystemHealthDto? _health;
    private List<TelemetryLogDto>? _recent;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Api.GetSummaryAsync();
            _health = await Api.GetHealthSummaryAsync();
            _recent = await Api.GetRecentTelemetryAsync();
        }
        catch (Exception ex)
        {
            _loadError = "Couldn't reach the API. Is it running?";
            Console.Error.WriteLine(ex);
        }
    }

    private static string FormatUptime(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h {ts.Minutes}m" : $"{ts.Minutes}m {ts.Seconds}s";
    }
}