@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <div class="topbar-inner">
            <div class="brand">
                <span>Smart-X Telemetry</span>
                <span class="pulse-dot"><span class="ping"></span><span class="core"></span></span>
            </div>
                <nav class="nav-list">
                    <NavLink href="" Match="NavLinkMatch.All" class="nav-tab">Home</NavLink>
                    <NavLink href="dashboard" class="nav-tab">Overview</NavLink>
                    <NavLink href="command-stream" class="nav-tab">Command Stream</NavLink>
                    <NavLink href="anomalies" class="nav-tab">Anomaly Logs</NavLink>
                    <NavLink href="ingestion" class="nav-tab">Data Ingestion</NavLink>
                    <NavLink href="integrations" class="nav-tab">Integration</NavLink>
                    <NavLink href="health" class="nav-tab">System Health</NavLink>
                </nav>
        </div>
    </header>

    <main class="content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="alert-banner" style="justify-content: space-between;">
                    <span>Something went wrong loading this page.</span>
                    <button class="btn-secondary btn-sm" @onclick="Recover">Try again</button>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>

@code {
    private ErrorBoundary? _errorBoundary;
    private void Recover() => _errorBoundary?.Recover();
}